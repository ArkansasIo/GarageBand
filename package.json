{
  "name": "studiowave-daw",
  "version": "0.2.0",
  "private": true,
  "description": "StudioWave browser DAW with a TypeScript REST API and MySQL project storage.",
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch server/src/index.ts",
    "build:api": "tsc -p tsconfig.server.json",
    "start:api": "node dist/server/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.server.json"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.0",
    "express-rate-limit": "^7.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
